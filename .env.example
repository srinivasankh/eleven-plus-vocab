# Copy to .env and adjust. Never commit .env.

# Postgres connection string.
# With `docker compose up -d` (see docker-compose.yml) this default works as-is.
DATABASE_URL=postgres://wordspark:wordspark@localhost:5432/wordspark

# Separate database used by `npm run test:db` (integration tests wipe and reseed it).
TEST_DATABASE_URL=postgres://wordspark:wordspark@localhost:5432/wordspark_test

# Better Auth. Generate a real secret with:  openssl rand -base64 32
# (any long random string; production must use its own, never this placeholder)
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
# The address the app is served from (used for auth callbacks and cookie origin checks).
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Continue with Google". Leave empty to hide the button.
# Create a Web OAuth client at https://console.cloud.google.com/apis/credentials with the redirect
# URI http://localhost:3000/api/auth/callback/google (and the production one, see CLAUDE.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
